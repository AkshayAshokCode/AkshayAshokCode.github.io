---
import Base from '../layouts/Base.astro';
import { gameday as g } from '../data/gameday';
import { site } from '../data/site';
import PlayIcon from '../components/PlayIcon.astro';
---

<Base
  title="GameDay — the weekly game, minus the group-chat chaos"
  description={`${g.oneLiner} ${g.summary}`}
  icon="/gameday/icon.svg"
  image="/gameday/shots/01-group.jpg"
  themeColor="#0a0e0b"
  fonts="family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500"
>
  <div class="gd">
    <header class="wrap top">
      <a href="/gameday/" class="brand"><img src="/gameday/icon.svg" alt="" width="28" height="28" />GameDay</a>
      <a href={g.playStore} class="pop pop-sm" target="_blank" rel="noopener">Get the app</a>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <p class="eyebrow">Under the floodlights</p>
          <h1>The weekly game, minus the <span>group-chat chaos.</span></h1>
          <p class="sub">{g.oneLiner} {g.summary}</p>
          <div class="cta">
            <div class="buttons">
              <a href={g.playStore} class="pop" target="_blank" rel="noopener"><PlayIcon />Get it on Google Play</a>
              <a href={g.url} class="ghost" target="_blank" rel="noopener">Open on the web</a>
            </div>
            <p class="avail">{g.availability}</p>
          </div>
          <div class="hero-shots">
            {g.heroShots.map((s, i) => <img src={s.src} alt={s.alt} class={`h${i}`} width="540" height="960" />)}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <p class="eyebrow" data-reveal>The problem</p>
          <h2 data-reveal>WhatsApp is for talking about the game. Not organising it.</h2>
          <p class="intro" data-reveal>{g.problemIntro}</p>
          <div class="problems">
            {
              g.problems.map((p) => (
                <div class="card" data-reveal>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              ))
            }
          </div>
          <p class="callout" data-reveal>{g.problemOutro}</p>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <p class="eyebrow" data-reveal>What it does</p>
          <h2 data-reveal>One link. Who’s in, which day, fair teams, and who’s paid.</h2>
          <div class="features">
            {
              g.features.map((f) => (
                <article class="feature" data-reveal>
                  <img src={f.shot} alt={f.alt} width="540" height="960" loading="lazy" />
                  <div>
                    <h3>{f.title}</h3>
                    <ul>
                      {f.points.map((pt) => (
                        <li>{pt}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>

          <h3 class="sub-h" data-reveal>And the rest of the week</h3>
          <div class="extras">
            {
              g.extras.map((e) => (
                <div class="card" data-reveal>
                  <h4>{e.title}</h4>
                  <p>{e.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section floodlit">
        <div class="wrap">
          <p class="eyebrow" data-reveal>The feel</p>
          <h2 data-reveal>“Floodlit”</h2>
          <p class="intro" data-reveal>
            GameDay doesn’t look like an admin tool, because organising the weekly game shouldn’t feel like filing a report.
          </p>
          <div class="design">
            {
              g.design.map((d) => (
                <div data-reveal>
                  <span class="dot" aria-hidden="true" />
                  <h4>{d.title}</h4>
                  <p>{d.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <p class="eyebrow" data-reveal>Product decisions</p>
          <h2 data-reveal>How it was decided</h2>
          <ol class="decisions">
            {
              g.decisions.map((d, i) => (
                <li data-reveal>
                  <span class="n">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h4>{d.title}</h4>
                    <p>{d.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <p class="eyebrow" data-reveal>Under the hood</p>
          <h2 data-reveal>Three native clients, one backend</h2>
          <div class="eng">
            {
              g.engineering.map((e) => (
                <div data-reveal>
                  <h4>{e.title}</h4>
                  <p>{e.body}</p>
                </div>
              ))
            }
          </div>
          <ul class="stack" data-reveal>{g.stack.map((t) => <li>{t}</li>)}</ul>

          <dl class="numbers" data-reveal>
            {
              g.numbers.map((n) => (
                <div>
                  <dt>{n.label}</dt>
                  <dd>{n.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <section class="section">
        <div class="wrap split">
          <div>
            <p class="eyebrow" data-reveal>So far</p>
            <ol class="timeline">
              {
                g.timeline.map((t) => (
                  <li data-reveal>
                    <span>{t.date}</span>
                    <p>{t.text}</p>
                  </li>
                ))
              }
            </ol>
          </div>
          <div>
            <p class="eyebrow" data-reveal>What’s next</p>
            <ul class="next">{g.next.map((n) => <li data-reveal>{n}</li>)}</ul>
          </div>
        </div>
      </section>

      <section class="final">
        <div class="wrap">
          <h2 data-reveal>Stop counting heads in WhatsApp.</h2>
          <div class="buttons" data-reveal>
            <a href={g.playStore} class="pop" target="_blank" rel="noopener"><PlayIcon />Get it on Google Play</a>
            <a href={g.url} class="ghost" target="_blank" rel="noopener">Open on the web</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap foot">
      <p>Designed and built by <a href="/" class="u">{site.name}</a></p>
      <nav aria-label="GameDay legal">
        {g.legal.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </nav>
    </footer>
  </div>
</Base>

<style>
  .gd {
    --bg: #0a0e0b;
    --surface: #111712;
    --line: rgba(255, 255, 255, 0.08);
    --text: #f2f5ee;
    --muted: #8f998c;
    --flood: #e8ff47;
    --display: 'Space Grotesk', 'Inter', system-ui, sans-serif;
    background:
      radial-gradient(ellipse 60% 640px at 50% 0%, rgba(232, 255, 71, 0.13), transparent 70%) no-repeat,
      var(--bg);
    color: var(--text);
    min-height: 100vh;
  }
  .wrap {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  a {
    color: inherit;
  }
  .u {
    text-decoration-color: var(--muted);
    text-underline-offset: 3px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }

  /* NeoPop button, as in the app */
  .pop {
    display: inline-block;
    background: var(--flood);
    color: #0a0e0b;
    font-family: var(--display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.01em;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 10px;
    box-shadow: 4px 4px 0 #8a9a1f;
    transition:
      transform 0.08s,
      box-shadow 0.08s;
  }
  .pop:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 #8a9a1f;
  }
  .pop :global(svg) {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    vertical-align: -2px;
  }
  .ghost {
    display: inline-block;
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    padding: 13px 22px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: border-color 0.2s;
  }
  .ghost:hover {
    border-color: var(--text);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 16px;
  }
  .pop-sm {
    font-size: 14px;
    padding: 9px 16px;
    box-shadow: 3px 3px 0 #8a9a1f;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--flood);
    box-shadow: 0 0 10px var(--flood);
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--display);
    letter-spacing: -0.02em;
  }

  /* Hero */
  .hero {
    position: relative;
    text-align: center;
    padding: clamp(56px, 9vw, 110px) 0 0;
    overflow: hidden;
  }
  .hero .eyebrow {
    justify-content: center;
  }
  h1 {
    font-size: clamp(42px, 7vw, 88px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 900px;
    margin: 0 auto 24px;
  }
  h1 span {
    color: var(--flood);
  }
  .sub {
    font-size: clamp(17px, 1.8vw, 20px);
    color: var(--muted);
    max-width: 620px;
    margin: 0 auto 36px;
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .avail {
    font-size: 14px;
    color: var(--muted);
    margin: 0;
    max-width: 440px;
  }
  .hero-shots {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: clamp(48px, 7vw, 80px);
    height: clamp(300px, 48vw, 560px);
  }
  .hero-shots img {
    width: clamp(160px, 24vw, 300px);
    height: auto;
    border-radius: 22px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.9);
  }
  .h0,
  .h2 {
    margin-top: 8%;
    opacity: 0.85;
  }
  .h0 {
    transform: rotate(-5deg) translateX(14%);
  }
  .h2 {
    transform: rotate(5deg) translateX(-14%);
  }
  .h1 {
    position: relative;
    z-index: 1;
  }

  /* Sections */
  .section {
    border-top: 1px solid var(--line);
    padding: clamp(72px, 10vw, 120px) 0;
  }
  h2 {
    font-size: clamp(30px, 4.4vw, 52px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 820px;
    margin: 0 0 20px;
  }
  .intro {
    color: var(--muted);
    font-size: 18px;
    max-width: 640px;
    margin: 0 0 48px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
  }
  .card h3,
  .card h4 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .card p {
    color: var(--muted);
    font-size: 15px;
    margin: 0;
  }
  .problems,
  .extras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .callout {
    margin: 40px 0 0;
    padding-left: 20px;
    border-left: 3px solid var(--flood);
    font-size: clamp(18px, 2vw, 22px);
    max-width: 720px;
  }

  /* Features */
  .features {
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 8vw, 96px);
    margin: clamp(48px, 7vw, 80px) 0 clamp(80px, 10vw, 120px);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(220px, 300px) 1fr;
    gap: clamp(32px, 7vw, 96px);
    align-items: center;
  }
  .feature:nth-child(even) img {
    order: 2;
  }
  .feature img {
    width: 100%;
    height: auto;
    border-radius: 22px;
    border: 1px solid var(--line);
  }
  .feature h3 {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    margin: 0 0 20px;
  }
  .feature ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 520px;
  }
  .feature li {
    position: relative;
    padding-left: 22px;
    color: var(--muted);
  }
  .feature li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--flood);
  }
  .sub-h {
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 24px;
  }

  /* Floodlit */
  .floodlit {
    background: radial-gradient(ellipse 50% 70% at 85% 0%, rgba(232, 255, 71, 0.08), transparent 70%);
  }
  .design {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .dot {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--flood);
    box-shadow: 0 0 24px 4px rgba(232, 255, 71, 0.35);
    margin-bottom: 20px;
  }
  .design h4,
  .eng h4,
  .decisions h4 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .design p,
  .eng p,
  .decisions p {
    color: var(--muted);
    font-size: 15px;
    margin: 0;
  }

  /* Decisions */
  .decisions {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 48px;
  }
  .decisions li {
    display: flex;
    gap: 20px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .n {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--flood);
    padding-top: 3px;
  }

  /* Engineering */
  .eng {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    margin-top: 40px;
  }
  .eng > div {
    background: var(--bg);
    padding: 28px;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .numbers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: clamp(56px, 8vw, 88px) 0 0;
  }
  .numbers div {
    display: flex;
    flex-direction: column-reverse;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .numbers dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1;
    color: var(--flood);
  }
  .numbers dt {
    color: var(--muted);
    font-size: 14px;
    margin-top: 10px;
  }

  /* Timeline + next */
  .split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(48px, 8vw, 112px);
  }
  .timeline {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .timeline li {
    position: relative;
    padding: 0 0 28px 24px;
    border-left: 1px solid var(--line);
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--flood);
  }
  .timeline span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .timeline p {
    margin: 6px 0 0;
  }
  .next {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .next li {
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  /* Final CTA */
  .final {
    text-align: center;
    padding: clamp(80px, 12vw, 140px) 0;
    background: radial-gradient(ellipse 50% 80% at 50% 100%, rgba(232, 255, 71, 0.12), transparent 70%);
    border-top: 1px solid var(--line);
  }
  .final h2 {
    margin: 0 auto 32px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: 32px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .foot p {
    margin: 0;
  }
  .foot nav {
    display: flex;
    gap: 24px;
  }
  .foot nav a {
    text-decoration: none;
  }
  .foot nav a:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .problems,
    .extras {
      grid-template-columns: 1fr 1fr;
    }
    .design,
    .numbers {
      grid-template-columns: 1fr 1fr;
    }
    .decisions,
    .eng,
    .split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .problems,
    .extras {
      grid-template-columns: 1fr;
    }
    .feature {
      grid-template-columns: 1fr;
    }
    .feature:nth-child(even) img {
      order: 0;
    }
    .feature img {
      max-width: 300px;
    }
    .hero-shots {
      height: auto;
    }
    .h0,
    .h2 {
      display: none;
    }
    .hero-shots img {
      width: min(72%, 300px);
    }
  }
</style>
