---
import { gameday } from '../data/projects';
---

<section class="gameday" id="gameday">
  <div class="container">
    <div class="head" data-reveal>
      <p class="label">Featured project</p>
      <h2>GameDay</h2>
      <p class="tagline">{gameday.tagline}</p>
      <p class="summary">{gameday.summary}</p>
      <div class="actions">
        <a href={gameday.url} class="btn" target="_blank" rel="noopener">Open the web app ↗</a>
        <span class="note">The source is private. I’m happy to walk through it.</span>
      </div>
    </div>

    <dl class="facts" data-reveal>
      {
        gameday.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="problem" data-reveal>
      <p class="label">The problem</p>
      <p class="quote">{gameday.problem}</p>
    </div>

    <div class="tour">
      <ol class="steps">
        {
          gameday.tour.map((s, i) => (
            <li class:list={['step', { 'is-active': i === 0 }]} data-step={i}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <img class="inline-shot" src={s.image} alt={s.alt} loading="lazy" width="780" height="1520" />
            </li>
          ))
        }
      </ol>
      <div class="phone-wrap" aria-hidden="true">
        <div class="phone">
          {
            gameday.tour.map((s, i) => (
              <img
                class:list={['screen', { 'is-active': i === 0 }]}
                data-screen={i}
                src={s.image}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                width="780"
                height="1520"
              />
            ))
          }
        </div>
      </div>
    </div>

    <div class="eng">
      <p class="label" data-reveal>Under the hood</p>
      <h3 class="eng-title" data-reveal>One backend, three clients</h3>
      <div class="eng-grid">
        {
          gameday.engineering.map((e) => (
            <div class="eng-item" data-reveal>
              <h4>{e.title}</h4>
              <p>{e.body}</p>
            </div>
          ))
        }
      </div>
      <ul class="stack" data-reveal>
        {gameday.stack.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .gameday {
    border-top: 1px solid var(--line);
    padding: clamp(72px, 10vw, 120px) 0;
  }

  h2 {
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    margin: 0 0 20px;
  }
  .tagline {
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0 0 16px;
    max-width: 720px;
  }
  .summary {
    color: var(--muted);
    max-width: 620px;
    margin: 0 0 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .btn {
    display: inline-block;
    background: var(--accent);
    color: #0a0b0a;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 10px;
    box-shadow: 0 3px 0 #9fb320;
    transition:
      transform 0.1s,
      box-shadow 0.1s;
  }
  .btn:active {
    transform: translateY(3px);
    box-shadow: 0 0 0 #9fb320;
  }
  .note {
    color: var(--muted);
    font-size: 14px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: clamp(48px, 7vw, 72px) 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
    font-size: 15px;
  }

  .problem {
    margin: clamp(80px, 12vw, 140px) 0;
    max-width: 860px;
  }
  .quote {
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    margin: 0;
  }

  /* Tour: steps on the left, sticky phone on the right */
  .tour {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 340px);
    gap: clamp(40px, 8vw, 120px);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 440px;
    opacity: 0.3;
    transition: opacity 0.4s;
  }
  .step.is-active {
    opacity: 1;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .step h3 {
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 12px;
  }
  .step p {
    color: var(--muted);
    margin: 0;
  }
  .inline-shot {
    display: none;
  }
  .phone-wrap {
    position: sticky;
    top: calc(50vh - min(34vw, 330px));
    height: fit-content;
  }
  .phone {
    position: relative;
    aspect-ratio: 780 / 1520;
    max-height: 80vh;
    margin-left: auto;
    border-radius: 36px;
    padding: 10px;
    background: #050605;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 30px 80px -30px rgba(228, 255, 58, 0.18);
  }
  .screen {
    position: absolute;
    inset: 10px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    object-fit: cover;
    object-position: top;
    border-radius: 27px;
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .screen.is-active {
    opacity: 1;
    transform: none;
  }

  /* Engineering */
  .eng {
    margin-top: clamp(80px, 12vw, 140px);
  }
  .eng-title {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0 0 40px;
  }
  .eng-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .eng-item {
    background: var(--bg);
    padding: 28px;
  }
  h4 {
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .eng-item p {
    color: var(--muted);
    font-size: 15px;
    margin: 0;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .eng-grid {
      grid-template-columns: 1fr;
    }
    .tour {
      grid-template-columns: 1fr;
    }
    .phone-wrap {
      display: none;
    }
    .step {
      min-height: 0;
      opacity: 1;
      margin-bottom: 64px;
      max-width: none;
    }
    .inline-shot {
      display: block;
      width: min(100%, 320px);
      height: auto;
      margin-top: 24px;
      border-radius: 24px;
      border: 1px solid var(--line);
    }
  }
  @media (max-width: 480px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
