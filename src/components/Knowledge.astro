---
import { resources } from '../data/projects';
import SectionTitle from './SectionTitle.astro';
---

<section class="section knowledge" id="knowledge">
  <div class="container">
    <p class="eyebrow">Open knowledge</p>
    <SectionTitle text="Learning in *public*" />

    <div class="list">
      {
        resources.map((r) => (
          <a href={r.repo} target="_blank" rel="noopener" class="item" data-reveal>
            <span class="stat">{r.stat}</span>
            <div>
              <h3>{r.title}</h3>
              <p>{r.description}</p>
            </div>
            <span class="go" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .knowledge {
    background: var(--bg-2);
  }
  .list {
    border-top: 1px solid var(--line);
  }
  .item {
    display: grid;
    grid-template-columns: clamp(90px, 14vw, 180px) 1fr auto;
    gap: 24px;
    align-items: center;
    padding: clamp(28px, 4vw, 44px) 0;
    border-bottom: 1px solid var(--line);
    position: relative;
    isolation: isolate;
  }
  .item::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    background: var(--grad);
    opacity: 0;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1), opacity 0.45s;
    z-index: -1;
  }
  .item:hover::before {
    opacity: 0.12;
    transform: scaleY(1);
  }
  .stat {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
  }
  h3 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 32px);
    margin: 0 0 6px;
  }
  p {
    color: var(--muted);
    margin: 0;
  }
  .go {
    font-size: 28px;
    transition: transform 0.3s;
  }
  .item:hover .go {
    transform: translate(4px, -4px) rotate(10deg);
  }
  @media (max-width: 560px) {
    .item {
      grid-template-columns: 1fr auto;
    }
    .stat {
      grid-column: 1 / -1;
    }
  }
</style>
