---
import { site } from '../data/site';

const [first, ...rest] = site.name.split(' ');
const last = rest.join(' ');
const chars = (s: string) => [...s];

const stats = [
  { value: 18, suffix: '', label: 'open-source repos' },
  { value: 20, suffix: '+', label: 'design patterns documented' },
  { value: 2, suffix: '', label: 'platforms — Android & iOS' },
];
---

<section class="hero" id="top">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="eyebrow" data-intro>{site.role} · {site.location}</p>

    <h1 class="hero-title" aria-label={site.name}>
      <span class="line" aria-hidden="true">
        {chars(first).map((c) => <span class="char">{c}</span>)}
      </span>
      <span class="line line-outline" aria-hidden="true">
        {chars(last).map((c) => <span class="char">{c}</span>)}
      </span>
    </h1>

    <div class="hero-bottom">
      <p class="hero-sub" data-intro>{site.intro}</p>
      <div class="hero-cta" data-intro>
        <a href="#work" class="btn btn-primary" data-magnetic>See my work <span aria-hidden="true">↓</span></a>
        <a href={site.github} class="btn btn-ghost" data-magnetic target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </div>

    <dl class="stats" data-intro>
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>
              <span data-count={s.value}>{s.value}</span>
              {s.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 140px 0 64px;
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-glow {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    right: -25vmax;
    top: -25vmax;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.35), transparent 60%);
    filter: blur(40px);
    animation: drift 14s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes drift {
    to {
      transform: translate(-12vmax, 18vmax) scale(1.15);
    }
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(48px, 11.5vw, 176px);
    line-height: 0.88;
    letter-spacing: -0.045em;
    margin: 0 0 clamp(32px, 5vw, 56px);
  }
  .line {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    padding-bottom: 0.04em;
  }
  .char {
    display: inline-block;
  }
  .line-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text);
    padding-left: clamp(0px, 8vw, 140px);
  }
  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 48px;
    align-items: flex-end;
    justify-content: space-between;
  }
  .hero-sub {
    max-width: 520px;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--muted);
    margin: 0;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stats {
    margin: clamp(56px, 8vw, 96px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    padding: 24px 20px 0 0;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1;
  }
  .stats dt {
    color: var(--muted);
    font-size: 14px;
    margin-top: 8px;
  }
  @media (max-width: 640px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
