---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  size?: 'lg' | 'sm';
}
const { project, size = 'lg' } = Astro.props;
const [a, b] = project.accent;
const n = (count: number) => Array.from({ length: count }, (_, i) => i);
---

<div class:list={['art', size]} style={`--a:${a};--b:${b}`} data-tilt>
  <div class="phone">
    <div class="notch"></div>
    <div class="screen">
      {
        project.image ? (
          <img src={project.image} alt={`${project.title} screenshot`} loading="lazy" />
        ) : (
          <div class:list={['pattern', `p-${project.pattern}`]} aria-hidden="true">
            {project.pattern === 'rings' && n(4).map((i) => <span style={`--i:${i}`} />)}
            {project.pattern === 'bars' && n(7).map((i) => <span style={`--i:${i}`} />)}
            {project.pattern === 'grid' && n(6).map((i) => <span style={`--i:${i}`} />)}
            {project.pattern === 'orbit' && (
              <>
                <span class="ring" />
                <span class="dot" />
                <b>25:00</b>
              </>
            )}
            {project.pattern === 'wave' && n(3).map((i) => <span style={`--i:${i}`} />)}
            {project.pattern === 'stack' && n(3).map((i) => <span style={`--i:${i}`} />)}
          </div>
        )
      }
    </div>
  </div>
  {
    size === 'lg' &&
      project.tags.slice(0, 3).map((t, i) => (
        <span class:list={['float', `f${i}`]} data-speed={0.6 + i * 0.4}>
          {t}
        </span>
      ))
  }
</div>

<style>
  .art {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--a) 35%, transparent), transparent 60%),
      radial-gradient(circle at 80% 90%, color-mix(in srgb, var(--b) 30%, transparent), transparent 55%),
      var(--surface);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    perspective: 900px;
    overflow: hidden;
  }
  .art.sm {
    aspect-ratio: 4 / 3;
  }
  .phone {
    width: 46%;
    aspect-ratio: 9 / 18.5;
    border-radius: 14% / 7%;
    background: #05050a;
    padding: 3.2%;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 40px 80px -20px color-mix(in srgb, var(--a) 60%, transparent);
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .sm .phone {
    width: 34%;
    transform: translateY(18%);
  }
  .notch {
    position: absolute;
    top: 4%;
    left: 50%;
    width: 28%;
    height: 3%;
    transform: translateX(-50%);
    background: #05050a;
    border-radius: 99px;
    z-index: 2;
  }
  .screen {
    width: 100%;
    height: 100%;
    border-radius: 11% / 5.5%;
    overflow: hidden;
    background: linear-gradient(160deg, var(--a), var(--b));
    position: relative;
  }
  .screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pattern {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  /* rings — sensor pulse */
  .p-rings span {
    position: absolute;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.85);
    animation: pulse 3.2s ease-out infinite;
    animation-delay: calc(var(--i) * 0.8s);
    opacity: 0;
  }
  @keyframes pulse {
    0% {
      transform: scale(0.3);
      opacity: 1;
    }
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  /* bars — battery / level */
  .p-bars {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6%;
    padding: 0 12% 22%;
  }
  .p-bars span {
    flex: 1;
    height: 50%;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 6px;
    transform-origin: bottom;
    animation: level 2.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.35s);
  }
  @keyframes level {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1.2);
    }
  }

  /* grid — notes */
  .p-grid {
    grid-template-columns: 1fr 1fr;
    gap: 7%;
    padding: 22% 10% 10%;
    align-content: start;
  }
  .p-grid span {
    width: 100%;
    aspect-ratio: 1 / 1.1;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.82);
    animation: pop 4s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.4s);
  }
  .p-grid span:nth-child(3n + 2) {
    aspect-ratio: 1 / 1.5;
  }
  @keyframes pop {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.85;
    }
    50% {
      transform: translateY(-8%);
      opacity: 1;
    }
  }

  /* orbit — timer */
  .p-orbit .ring {
    position: absolute;
    width: 66%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.35);
  }
  .p-orbit .dot {
    position: absolute;
    width: 66%;
    aspect-ratio: 1;
    animation: spin 6s linear infinite;
  }
  .p-orbit .dot::after {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 16px #fff;
  }
  .p-orbit b {
    font-family: var(--font-mono);
    color: #fff;
    font-size: clamp(14px, 2.2vw, 26px);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* wave — speech */
  .p-wave span {
    position: absolute;
    width: 200%;
    height: 22%;
    left: 0;
    top: calc(36% + var(--i) * 10%);
    background: radial-gradient(ellipse 25% 50% at 25% 100%, transparent 70%, rgba(255, 255, 255, 0.8) 72%, transparent 76%);
    background-size: 50% 100%;
    animation: wave 3s linear infinite;
    animation-delay: calc(var(--i) * -1s);
    opacity: calc(1 - var(--i) * 0.25);
  }
  @keyframes wave {
    to {
      transform: translateX(-50%);
    }
  }

  /* stack — media cards */
  .p-stack span {
    position: absolute;
    width: 64%;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    background: rgba(255, 255, 255, calc(0.9 - var(--i) * 0.25));
    animation: fan 4s ease-in-out infinite alternate;
    z-index: calc(3 - var(--i));
    --r: calc((var(--i) - 1) * 12deg);
  }
  @keyframes fan {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(var(--r)) translateX(calc((var(--i) - 1) * 18%));
    }
  }

  .float {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(10, 10, 18, 0.7);
    border: 1px solid var(--line);
    backdrop-filter: blur(8px);
    white-space: nowrap;
  }
  .f0 {
    top: 14%;
    left: 8%;
  }
  .f1 {
    top: 46%;
    right: 6%;
  }
  .f2 {
    bottom: 12%;
    left: 14%;
  }
</style>
