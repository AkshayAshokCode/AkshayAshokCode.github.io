---
import { site, skills } from '../data/site';
---

<section class="section" id="about">
  <div class="container">
    <p class="eyebrow">About</p>
    <p class="statement" data-highlight>
      {site.about.split(' ').map((w) => <span>{w} </span>)}
    </p>

    <div class="skills" data-reveal>
      <h3>Toolkit</h3>
      <ul>
        {skills.map((s) => <li class="chip">{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .statement {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 60px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 clamp(64px, 9vw, 120px);
  }
  :global(.js) .statement span {
    opacity: 0.15;
  }
  .skills {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  h3 {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 6px 0 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    font-size: 14px;
    padding: 10px 18px;
    color: var(--text);
  }
  @media (max-width: 640px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
</style>
