---
import { site } from '../data/site';
---

<section class="container intro" id="top">
  <h1>{site.name}</h1>
  <p>{site.intro}</p>
  <a href="#gameday" class="link-arrow">Currently building GameDay ↓</a>
</section>

<style>
  .intro {
    padding-top: clamp(64px, 12vw, 140px);
    padding-bottom: clamp(72px, 12vw, 140px);
  }
  h1 {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0 0 24px;
  }
  p {
    max-width: 620px;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 32px;
  }
  a {
    font-size: 15px;
  }
</style>
