---
import { skills } from '../data/site';
---

<div class="marquee" aria-label={`Skills: ${skills.join(', ')}`}>
  <div class="track" aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="group">
          {skills.map((s) => (
            <span class="item">
              {s}
              <i>✦</i>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    border-block: 1px solid var(--line);
    padding: 22px 0;
    overflow: hidden;
    background: var(--bg-2);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .group {
    display: flex;
  }
  .item {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 3vw, 36px);
    padding-right: 36px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 36px;
  }
  .item i {
    font-style: normal;
    font-size: 0.6em;
    color: var(--accent-2);
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
